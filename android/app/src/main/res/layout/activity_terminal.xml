<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/haus_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:background="@color/haus_bg_elevated">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@color/haus_accent" />

        <TextView
            android:id="@+id/tvUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/haus_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terminal_status_connecting"
            android:textColor="@color/haus_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRouter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/terminal_open_web_ui"
            android:textSize="11sp"
            android:minHeight="32dp"
            android:padding="4dp"
            style="@style/Haus.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/terminal_keys_hide"
            android:textSize="11sp"
            android:minHeight="32dp"
            android:padding="4dp"
            style="@style/Haus.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/terminal_reconnect"
            android:textSize="11sp"
            android:minHeight="32dp"
            android:padding="4dp"
            android:visibility="gone"
            style="@style/Haus.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/terminal_logout"
            android:textSize="11sp"
            android:minHeight="32dp"
            android:padding="4dp"
            style="@style/Haus.Button.Outlined" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/haus_divider" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <HorizontalScrollView
        android:id="@+id/keybarScroller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/haus_bg_elevated"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/keybar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp" />
    </HorizontalScrollView>
</LinearLayout>